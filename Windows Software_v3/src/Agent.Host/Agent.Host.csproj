<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Agent.Host</RootNamespace>
    <AssemblyName>Centrix.Host</AssemblyName>
    <Product>CENTRIX Host</Product>
    <AssemblyTitle>CENTRIX Host</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Screenshots must capture real pixels on scaled displays. Without per-monitor
         awareness Windows virtualizes the screen size and CopyFromScreen returns a stretched,
         blurry image. Set here rather than in the manifest because Windows Forms configures
         DPI mode itself and rejects the manifest form (WFO0003). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Required by the [LibraryImport] source generator used for the Win32 interop in
         NativeMethods and TrayIconService. No hand-written unsafe blocks exist here. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <!-- Screenshot capture uses System.Drawing (Graphics.CopyFromScreen + JPEG encode), which
         ships in the Windows Desktop SDK this project already targets - no package needed. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agent.Core\Agent.Core.csproj" />
  </ItemGroup>

</Project>
