<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    CENTRIX Agent installer.

    What it does that a file copy does not: registers the SYSTEM service with the SCM and its
    recovery actions, writes the install-time configuration through the agent's own
    configuration step, and gives IT a supported uninstall and upgrade path.

    Both install modes matter and are the same package:

      Interactive - an administrator runs the MSI and fills in the server, token and transport on
                    the configuration page.
      Silent      - the same values arrive as public properties, which is how a real fleet is
                    deployed (GPO, Intune, ConfigMgr):

        msiexec /i CentrixAgent.msi /qn ^
                SERVERURL=https://monitoring.example.com ENROLLMENTTOKEN=<token>
  -->

  <Package Name="CENTRIX Agent"
           Manufacturer="CENTRIX"
           Version="$(AgentVersion)"
           UpgradeCode="1E9665BB-025A-4F53-A342-B1EE3C6CBDEA"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="CENTRIX Agent - workplace productivity telemetry under company monitoring policy" />

    <!-- AllowSameVersionUpgrades so a rebuild of the same version replaces the installed one
         rather than installing alongside it, which is what happens during a pilot. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed. Uninstall it before installing this one." />

    <MediaTemplate EmbedCab="yes" />

    <!-- The agent publishes win-x64 only. Refusing here beats installing a service that cannot
         start and leaving an administrator to work out why from the Event Log. -->
    <Launch Condition="VersionNT64"
            Message="[ProductName] requires 64-bit Windows." />

    <!--
      Required configuration, enforced only when there is no wizard to collect it.

      LaunchConditions run at the very start of the sequence - before AgentConfigDlg, where these
      values are typed. Requiring them unconditionally therefore aborted the interactive install on
      the Welcome page, because SERVERURL is necessarily empty that early. The gate is UILevel: a
      full UI install (UILevel = 5) shows AgentConfigDlg, whose Next button stays disabled until
      the same three rules are satisfied, so the launch conditions must stand aside for it. A
      silent or reduced-UI install (UILevel &lt; 5) shows no such dialog, so here the conditions are
      what turn a forgotten property into an immediate, named failure rather than a service that
      installs and then cannot enroll.
    -->
    <Launch Condition="Installed OR SERVERURL OR UILevel = 5"
            Message="SERVERURL is required, for example SERVERURL=https://monitoring.example.com" />
    <Launch Condition="Installed OR ENROLLMENTTOKEN OR UILevel = 5"
            Message="ENROLLMENTTOKEN is required. Take it from the dashboard under Settings - Organization." />
    <Launch Condition="Installed OR UILevel = 5 OR SERVERURL ~&lt;&lt; &quot;https://&quot; OR ALLOWINSECUREHTTP = &quot;1&quot;"
            Message="SERVERURL must be HTTPS. Pass ALLOWINSECUREHTTP=1 only for a local test server." />

    <Feature Id="AgentFeature" Title="CENTRIX Agent" Level="1">
      <ComponentGroupRef Id="AgentBinaries" />
      <ComponentRef Id="AgentServiceComponent" />
    </Feature>

    <!--
      Configuration properties.

      Authored inside Package rather than in a Fragment of their own. A fragment is only linked in
      if something references it, and a property mentioned solely in a condition is not a
      reference - so the same authoring in a fragment compiles, links, and silently produces an
      MSI with none of these in it. The same reasoning puts the custom action below here, and the
      dialog behind an explicit UIRef.

      Secure="yes" on all three is what lets a value typed into the UI, or passed on the command
      line, survive the handover to the elevated half of the install. Without it the deferred
      action runs with them empty and writes a configuration with no server in it.
    -->
    <Property Id="SERVERURL" Secure="yes" />

    <!-- Hidden as well: the enrollment token lets a machine join the fleet, and an MSI log is a
         file that gets attached to helpdesk tickets. -->
    <Property Id="ENROLLMENTTOKEN" Secure="yes" Hidden="yes" />

    <!-- Left empty rather than "0" so the checkbox and the MSI conditions agree on what unset
         means - a property set to "0" is still set as far as a bare property condition is
         concerned. -->
    <Property Id="ALLOWINSECUREHTTP" Secure="yes" />

    <!-- Data lifecycle: preserve by default; opt into clean install or purge explicitly. -->
    <Property Id="CLEANINSTALL" Secure="yes" />
    <Property Id="PURGEDATA" Secure="yes" />

    <SetProperty Id="AGENTDATADIR"
           After="CostFinalize"
           Sequence="execute"
           Condition="CLEANINSTALL = &quot;1&quot; OR PURGEDATA = &quot;1&quot;"
           Value="[CommonAppDataFolder]Centrix" />

    <!--
      Install-time configuration.

      Runs the agent's own configure step, which creates ProgramData, applies its ACLs and writes
      agent.config.json.

      Delegated to the agent rather than written here as MSI file authoring on purpose: the
      directory layout and its permissions are something the service depends on at runtime, so
      there is one implementation of it, in the codebase that has to agree with it. An installer
      that wrote the JSON itself would be a second definition free to drift.

      Deferred and non-impersonated because it writes under ProgramData as LocalSystem, and
      Return="check" so a bad server URL or a denied ACL rolls the whole install back instead of
      leaving a registered service with no configuration to start from.
    -->
    <CustomAction Id="ConfigureAgent"
                  DllEntry="WixQuietExec64"
                  BinaryRef="Wix4UtilCA_X64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!--
      A deferred action cannot read properties, so the command line is baked into a property of
      the same name immediately before it runs.

      The transport exception is carried in a second property rather than by authoring two
      variants of the command line: two SetProperty elements with the same Id would generate the
      same custom action twice, and an undefined property formats to nothing, so one line covers
      both cases. Sequenced before the line that consumes it, not merely before the action.
    -->
    <SetProperty Id="AGENTINSECUREFLAG"
                 Before="SetConfigureAgent"
                 Sequence="execute"
                 Condition="ALLOWINSECUREHTTP = &quot;1&quot;"
                 Value="--allow-insecure-http" />

    <SetProperty Id="ConfigureAgent"
                 Before="ConfigureAgent"
                 Sequence="execute"
                 Value="&quot;[#ServiceExecutable]&quot; --configure --server-url &quot;[SERVERURL]&quot; --enrollment-token &quot;[ENROLLMENTTOKEN]&quot; [AGENTINSECUREFLAG]" />

    <InstallExecuteSequence>
      <!-- After the files exist and before the SCM is told to start the service, which reads the
           configuration this writes and refuses to start without it. -->
      <Custom Action="ConfigureAgent" After="InstallFiles" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UIRef Id="AgentConfigDlgUI" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
  </Package>

  <!-- ==================================================================== -->
  <!-- Payload                                                              -->
  <!-- ==================================================================== -->
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CENTRIX" />
    </StandardDirectory>

    <!--
      Everything except the service executable, which needs a component of its own to carry the
      service registration below. Harvested rather than listed because a self-contained,
      single-file publish still emits a handful of native side-by-side files, and a hand-written
      list would silently miss one on a runtime upgrade.
    -->
    <ComponentGroup Id="AgentBinaries" Directory="INSTALLFOLDER">
      <Files Include="$(AgentPublishDir)**">
        <!-- Carried by its own component below, for the service registration. -->
        <Exclude Files="$(AgentPublishDir)Centrix.Service.exe" />

        <!-- Symbols are a debugging aid, not a deliverable. They roughly double the payload and
             hand out the internals of software that runs as SYSTEM on every workstation. Kept in
             the publish directory, where a crash dump can still be resolved against them. -->
        <Exclude Files="$(AgentPublishDir)**\*.pdb" />

        <!-- Development overrides would otherwise override production settings on a real
             workstation - appsettings.Development.json wins over appsettings.json wherever the
             environment is not explicitly set. -->
        <Exclude Files="$(AgentPublishDir)**\appsettings.Development.json" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <!-- ==================================================================== -->
  <!-- The service                                                          -->
  <!-- ==================================================================== -->
  <Fragment>
    <Component Id="AgentServiceComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="ServiceExecutable" Source="$(AgentPublishDir)Centrix.Service.exe" KeyPath="yes" />

      <util:RemoveFolderEx Id="RemoveAgentDataOnCleanInstall"
                           On="install"
                           Property="AGENTDATADIR"
                           Condition="CLEANINSTALL = &quot;1&quot;" />
      <util:RemoveFolderEx Id="RemoveAgentDataOnUninstall"
                           On="uninstall"
                           Property="AGENTDATADIR"
                           Condition="PURGEDATA = &quot;1&quot;" />

      <!--
        LocalSystem, because the service reads USB device state through WMI, writes to a
        protected ProgramData directory and launches the per-user host into another terminal
        services session. Nothing here runs on the interactive desktop.
      -->
      <ServiceInstall Id="AgentServiceInstall"
                      Name="CentrixAgent"
                      DisplayName="CENTRIX Agent"
                      Description="Collects workplace productivity telemetry under company monitoring policy. See the notice in the system tray."
                      Type="ownProcess"
                      Start="auto"
                      Account="LocalSystem"
                      ErrorControl="normal"
                      Vital="yes">

        <!--
          Spec section 10: the agent must recover by itself. Restart 5 s after each of the first
          three failures, with the counter reset daily.

          The failure count resetting daily is the part that matters: a machine that crashes once
          a week never accumulates enough failures to stop being restarted, while a genuine crash
          loop stops hammering the Event Log after the third attempt.
        -->
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="5"
                            ResetPeriodInDays="1" />
      </ServiceInstall>

      <!--
        Stop on both install and uninstall: an upgrade has to release the executable lock before
        the new file can be written, and Wait="yes" is what makes the SCM's asynchronous stop
        synchronous enough for that to be true.
      -->
      <ServiceControl Id="AgentServiceControl"
                      Name="CentrixAgent"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>
  </Fragment>
</Wix>
