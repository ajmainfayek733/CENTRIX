# CENTRIX production environment for deploy/docker-compose.prod.yml.
#
#   cp .env.example .env && chmod 600 .env     # then fill in every REQUIRED value
#
# Compose reads this file for ${...} interpolation, and the api service also loads it whole via
# env_file, so any backend setting from Backend/.env.example can be added here.
#
# Leave optional settings commented out rather than blank. The API validates some of them as
# URLs, and an empty string fails that validation where an absent variable would not.

# -- Topology ------------------------------------------------------------------
# bundled-db = run Postgres in a container on this host.
# Remove it (leave the value empty) and set DATABASE_URL below to use Amazon RDS instead.
COMPOSE_PROFILES=bundled-db

# Image tag stamped on locally built images. deploy.sh sets it to the git commit automatically.
IMAGE_TAG=latest

# -- Time zone ---------------------------------------------------------------
# IANA zone the organization works in (for example Asia/Dhaka, Asia/Kolkata). Stored timestamps
# stay UTC; this sets what clock time and calendar day the dashboard and reports show. The
# dashboard bakes it in at build time, so changing it needs a redeploy, not just a restart.
APP_TIME_ZONE=UTC

# -- Public domain (REQUIRED) ----------------------------------------------------
# Bare hostname, no scheme or path. Needs a DNS A record pointing at the Elastic IP before first
# start. The dashboard is served at https://DOMAIN and the API at https://DOMAIN/api/v1.
# Agents are installed with -ServerUrl https://DOMAIN (not .../api).
DOMAIN=example.com
# Let's Encrypt account email: expiry and problem notices go here.
ACME_EMAIL=ops@example.com

# -- AWS (REQUIRED) --------------------------------------------------------------
# Credentials come from the EC2 instance role. Never put access keys in this file.
AWS_REGION=ap-south-1
SCREENSHOT_S3_BUCKET=centrix-screenshots-CHANGE-ME

# -- Database (REQUIRED) ---------------------------------------------------------
POSTGRES_USER=centrix
POSTGRES_DB=centrix
# Hex only, so it can sit inside a connection URL unescaped: openssl rand -hex 32
POSTGRES_PASSWORD=
# External database only (COMPOSE_PROFILES without bundled-db). Overrides the three values above.
# DATABASE_URL=postgresql://centrix:PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/centrix?sslmode=require

# -- Secrets (REQUIRED) ----------------------------------------------------------
# Generate each with: openssl rand -hex 32
# Rotating DEVICE_TOKEN_PEPPER invalidates every issued device key and forces the whole fleet to
# re-enroll. Treat it as permanent and back it up outside this host.
BETTER_AUTH_SECRET=
DEVICE_TOKEN_PEPPER=

# -- Password recovery email (EmailJS) --------------------------------------------
# All four blank disables password recovery (503) without blocking startup. Partial config is a
# startup error. See Backend/.env.example for the dashboard setting this needs.
EMAILJS_SERVICE_ID=
EMAILJS_PASSWORD_RESET_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
PASSWORD_RESET_EMAIL_TRANSPORT=server
APP_NAME=CENTRIX

# -- Backups ---------------------------------------------------------------------
# Destination for scripts/backup-postgres.sh. Defaults to a prefix inside the screenshot bucket.
BACKUP_S3_URI=s3://centrix-screenshots-CHANGE-ME/backups/postgres
BACKUP_RETENTION_DAYS=14

# -- Resource limits (sized for a t3a.medium, 4 GiB) ------------------------------
# Keep the sum of *_MEM_LIMIT under instance memory minus ~0.5 GiB for the OS and Docker.
POSTGRES_MEM_LIMIT=1g
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
API_MEM_LIMIT=768m
API_NODE_HEAP_MB=512
FRONTEND_MEM_LIMIT=640m
FRONTEND_NODE_HEAP_MB=384
CADDY_MEM_LIMIT=128m

# -- Tuning (optional; defaults suit 30-100 agents) ------------------------------
# DATABASE_POOL_MAX=10
# JSON_BODY_LIMIT=2mb
# RATE_LIMIT_ENROLL_PER_MIN=10
# RATE_LIMIT_INGEST_PER_MIN=200
# RATE_LIMIT_SCREENSHOT_PER_MIN=60
# RATE_LIMIT_UNAUTHENTICATED_PER_MIN=3000
# LOG_MAX_SIZE=20m
# LOG_MAX_FILES=5
