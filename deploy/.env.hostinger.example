# CENTRIX production environment for a Hostinger KVM VPS with self-hosted MinIO storage.
#
#   cp .env.hostinger.example .env && chmod 600 .env     # then fill in every REQUIRED value
#
# Used with deploy/docker-compose.prod.yml + deploy/docker-compose.minio.yml. deploy.sh selects the
# MinIO override automatically because STORAGE_BACKEND=minio. Every backend setting from
# Backend/.env.example can also be added here; the api service loads this whole file.
#
# Leave optional settings commented out rather than blank. The API validates some of them as
# URLs, and an empty string fails that validation where an absent variable would not.
#
# Generate each secret with: openssl rand -hex 32

# -- Topology ------------------------------------------------------------------
COMPOSE_PROFILES=bundled-db
IMAGE_TAG=latest
# "minio" stores screenshots and database backups on this host. "s3" is Amazon S3.
STORAGE_BACKEND=minio

# -- Public domain (REQUIRED) ----------------------------------------------------
# Bare hostname, no scheme or path. Its DNS A record (and AAAA, if present) must point at this
# VPS before first start, or Let's Encrypt certificate issuance fails.
DOMAIN=shineox.tech
# Let's Encrypt account email: expiry and problem notices go here.
ACME_EMAIL=ops@example.com

# -- Object storage: MinIO (REQUIRED) ----------------------------------------------
# The AWS SDK needs a region string even though MinIO has no regions. Its default is us-east-1.
AWS_REGION=us-east-1
SCREENSHOT_S3_BUCKET=centrix-screenshots
# Root account: used only by the MinIO server, the bootstrap container and the web console.
# Alphanumeric, 3+ characters. Password from `openssl rand -hex 32`.
MINIO_ROOT_USER=centrixadmin
MINIO_ROOT_PASSWORD=
# Service user the API and backup script sign requests with. Limited to the bucket above.
# Must differ from MINIO_ROOT_USER. Secret from `openssl rand -hex 32`.
MINIO_APP_ACCESS_KEY=centrixapp
MINIO_APP_SECRET_KEY=
# Backups land in this bucket under backups/postgres and expire after BACKUP_RETENTION_DAYS.
BACKUP_S3_URI=s3://centrix-screenshots/backups/postgres
BACKUP_RETENTION_DAYS=14
# Community MinIO no longer publishes official Docker images, so these pin the maintained
# pgsty fork. Replace with your own build or another image if you prefer.
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
# MINIO_MC_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z

# -- Database (REQUIRED) ---------------------------------------------------------
POSTGRES_USER=centrix
POSTGRES_DB=centrix
# Hex only, so it can sit inside a connection URL unescaped.
POSTGRES_PASSWORD=

# -- Secrets (REQUIRED) ----------------------------------------------------------
# Rotating DEVICE_TOKEN_PEPPER invalidates every issued device key and forces the whole fleet to
# re-enroll. Treat it as permanent and back it up outside this host.
BETTER_AUTH_SECRET=
DEVICE_TOKEN_PEPPER=

# -- Password recovery email (EmailJS) --------------------------------------------
# All four blank disables password recovery (503) without blocking startup. Partial config is a
# startup error. See Backend/.env.example for the dashboard setting this needs.
EMAILJS_SERVICE_ID=
EMAILJS_PASSWORD_RESET_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
PASSWORD_RESET_EMAIL_TRANSPORT=server
APP_NAME=CENTRIX

# -- Resource limits (sized for Hostinger KVM 4: 4 vCPU, 16 GiB) -------------------
# Keep the sum of *_MEM_LIMIT under VPS memory minus ~1 GiB for the OS and Docker.
POSTGRES_MEM_LIMIT=4g
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
API_MEM_LIMIT=1536m
API_NODE_HEAP_MB=1024
FRONTEND_MEM_LIMIT=1g
FRONTEND_NODE_HEAP_MB=768
CADDY_MEM_LIMIT=256m
MINIO_MEM_LIMIT=2g

# -- Tuning (optional; defaults suit 30-100 agents) ------------------------------
# DATABASE_POOL_MAX=10
# JSON_BODY_LIMIT=2mb
# RATE_LIMIT_ENROLL_PER_MIN=10
# RATE_LIMIT_INGEST_PER_MIN=200
# RATE_LIMIT_SCREENSHOT_PER_MIN=60
# RATE_LIMIT_UNAUTHENTICATED_PER_MIN=3000
# LOG_MAX_SIZE=20m
# LOG_MAX_FILES=5
