<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette. Same keys as Light.xaml, in the same order, so the two stay comparable
         at a glance. Not a straight inversion: the accent is lightened because #16A34A on a
         near-black surface fails contrast, and the surface sits above the background rather
         than below it, keeping the card-on-page relationship the light theme has. -->

    <Color x:Key="BackgroundColor">#09090B</Color>
    <Color x:Key="SurfaceColor">#18181B</Color>
    <Color x:Key="BorderColor">#27272A</Color>
    <Color x:Key="TextPrimaryColor">#FAFAFA</Color>
    <Color x:Key="TextSecondaryColor">#A1A1AA</Color>
    <Color x:Key="AccentColor">#22C55E</Color>
    <Color x:Key="AccentTextColor">#052E16</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="HoverColor">#27272A</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />

</ResourceDictionary>
