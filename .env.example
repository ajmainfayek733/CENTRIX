# Root environment for docker-compose.yml.
#
#   cp .env.example .env     # then fill in the three secrets below
#   docker compose up -d --build
#
# Compose reads this file automatically. Backend/.env is for running the API outside a container
# and is not used here.

# -- Database ------------------------------------------------------------------
POSTGRES_USER=monitoring
POSTGRES_DB=employee_monitor
# Required - compose refuses to start without it.
POSTGRES_PASSWORD=

# Only set this to override the composed value (e.g. to point at a managed Postgres instead of
# the bundled container). Left blank, it is derived from the three settings above.
# DATABASE_URL=postgresql://monitoring:password@postgres:5432/employee_monitor

# -- Secrets -------------------------------------------------------------------
# Both required. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Rotating DEVICE_TOKEN_PEPPER invalidates every already-issued device API key, forcing the
# whole fleet to re-enroll. Treat it as permanent.
BETTER_AUTH_SECRET=
DEVICE_TOKEN_PEPPER=

# -- URLs ----------------------------------------------------------------------
# Where the agents and the dashboard reach this API, and where the dashboard is served.
# These must be the addresses clients actually use, not localhost, once this leaves your machine.
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:5000

# Host port the API is published on.
API_PORT=5000

# -- Deployment topology -------------------------------------------------------
# Number of reverse proxies in front of the API container, or 'false' for direct exposure.
# Getting this wrong breaks per-IP rate limiting in one direction or the other - see the note at
# the top of docker-compose.yml.
TRUST_PROXY=false

# -- Tuning --------------------------------------------------------------------
# Defaults suit 30-100 agents. Raise the pool first if requests start queueing.
DATABASE_POOL_MAX=10
JSON_BODY_LIMIT=2mb
RATE_LIMIT_ENROLL_PER_MIN=10
RATE_LIMIT_INGEST_PER_MIN=200
RATE_LIMIT_SCREENSHOT_PER_MIN=60
RATE_LIMIT_UNAUTHENTICATED_PER_MIN=3000
