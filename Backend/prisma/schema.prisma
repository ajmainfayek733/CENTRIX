// Employee Monitoring — v3 schema.
//
// Hard rule for this schema: NO Json columns. Every telemetry field the Agent sends gets its
// own typed column, so the database is queryable by the reporting layer without unpacking a
// blob, and a malformed field fails at ingest validation rather than silently landing in a
// document nobody can index. Scalar lists (Postgres `text[]`) are used for genuinely
// repeated scalars in policy — they are real array columns, not serialized documents.
//
// Field names track "Windows Software_v3/docs/Features.md"; table names are snake_case via
// @@map so raw SQL / BI tools see conventional names.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums — every constrained field in Features.md is an enum rather than a free
// string, so bad values are rejected by Postgres itself.
// ---------------------------------------------------------------------------

/// Features.md "Activity Logs" → Type
enum ActivityType {
  Application
  Desktop
  Locked
  Idle
  Sleeping
  Disconnected
}

/// Features.md "Activity Logs" → Reason (why the activity session ended)
enum ActivityEndReason {
  UserInactivity
  ScreenLock
  Sleep
  Disconnect
  AppSwitch
  SessionEnd
}

/// Features.md "Activity Logs"/"Browser Activity log" → ProductivityTag
enum ProductivityTag {
  Productive
  Unproductive
  Blacklisted
  Neutral
}

/// Why an attendance session's LogoutTime was stamped. Covers the lock/shutdown/
/// hibernate/power-loss edge cases called out in Features.md "Attendace report".
enum SessionEndReason {
  Logout
  Lock
  Shutdown
  Restart
  Hibernate
  Sleep
  PowerLoss
  Disconnect
  /// Session was still open when the agent restarted — logout time is a recovered estimate.
  Recovered
}

enum UsbEventType {
  Connected
  Disconnected
}

/// Features.md "USB Logs" → DeviceType
enum UsbDeviceType {
  UsbStorage
  MobileDevice
  Hid
  Other
}

enum BrowserKind {
  Chrome
  Edge
  Firefox
  Brave
  Opera
  Vivaldi
  Other
}

enum UrlProtocol {
  Http
  Https
}

enum AlertSeverity {
  Information
  Warning
  High
  Critical
}

enum AlertState {
  New
  Shown
  Acknowledged
  Resolved
  Archived
}

/// What an alert fired about. Determines which of the nullable context columns on Alert
/// are populated — see the comments on that model.
enum AlertType {
  IdleThreshold
  BlacklistedApp
  BlacklistedWebsite
  UsbDeviceConnected
}

/// Whether a Category rule matches an application or a web domain.
enum CategoryTarget {
  Application
  Domain
}

enum UserRole {
  super_admin
  manager
  auditor
}

// ---------------------------------------------------------------------------
// Tenancy and people
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  /// HMAC of the shared enrollment token baked into the agent's install-time config
  /// (spec §11). Presented once at POST /api/v1/device/enroll to trade for a per-device
  /// API key; it is NOT accepted as a credential on any telemetry route. Only the HMAC is
  /// stored, so a database read cannot recover the token.
  enrollmentTokenHash String? @unique

  employees  Employee[]
  devices    Device[]
  policy     Policy?
  categories Category[]

  @@map("organizations")
}

model Employee {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String       @unique
  department     String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())

  devices Device[]

  @@index([organizationId])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Devices — Features.md "Device Information".
//
// Identity note: `deviceId` is the Windows MachineGuid and is the primary stable key.
// `macAddress` is recorded because Features.md calls it out as burned-into-hardware and
// stable across IP changes, but it is NOT used as the identity key — MAC is spoofable and
// multi-NIC machines report several.
// ---------------------------------------------------------------------------

model Device {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Windows MachineGuid — HKLM\SOFTWARE\Microsoft\Cryptography\MachineGuid.
  deviceId     String  @unique
  deviceName   String
  /// e.g. "64-bit operating system, x64-based processor"
  systemType   String?
  /// e.g. "Windows 11 Pro"
  edition      String?
  /// e.g. "10.0.26200"
  version      String?
  macAddress   String?
  agentVersion String?

  /// HMAC-SHA256 of the device API key. The key itself is shown once at enrollment.
  apiKeyHash String @unique

  isActive  Boolean   @default(true)
  lastSeen  DateTime?
  createdAt DateTime  @default(now())

  attendanceSessions AttendanceSession[]
  activityMetrics    ActivityMetric[]
  activitySessions   ActivitySession[]
  browserActivities  BrowserActivity[]
  usbEvents          UsbEvent[]
  alerts             Alert[]
  screenshots        Screenshot[]
  consents           ConsentRecord[]

  @@index([organizationId])
  @@index([employeeId])
  @@index([macAddress])
  @@map("devices")
}

// ---------------------------------------------------------------------------
// Attendance — Features.md "Attendace report".
//
// One row per OS logon session. `logoutTime` is written repeatedly (last-write-wins) as
// the agent observes lock/sleep/shutdown, so an unexpected power loss still leaves the
// last known good timestamp rather than a null.
// ---------------------------------------------------------------------------

model AttendanceSession {
  id       String @id @default(uuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// Windows SID of the logged-on user — the agent never sends usernames.
  userSid String
  /// Agent-generated GUID identifying this logon session; the dedup/idempotency key.
  sessionId String @unique

  loginTime  DateTime
  logoutTime DateTime?
  endReason  SessionEndReason?

  /// Local calendar date the session belongs to, for day-grained attendance reporting.
  workDate DateTime @db.Date

  /// Rolled up from ActivitySession by the reporting layer; denormalized for fast lists.
  totalActiveSeconds Int @default(0)
  totalIdleSeconds   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityMetrics  ActivityMetric[]
  activitySessions ActivitySession[]
  usbEvents        UsbEvent[]

  @@index([deviceId, workDate])
  @@index([userSid, workDate])
  @@map("attendance_sessions")
}

// ---------------------------------------------------------------------------
// Activity level metric — Features.md "Activity Level Metric".
//
// PRIVACY: counts only. There is deliberately no column here that could hold a key,
// a character, or a sequence — spec §1.2 and §6 exclude keystroke content entirely.
// ---------------------------------------------------------------------------

model ActivityMetric {
  id       String @id @default(uuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  sessionId         String
  attendanceSession AttendanceSession? @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  /// Agent-generated GUID per emitted sample; dedup key for at-least-once delivery.
  clientEventId String @unique

  keyCount   Int @default(0)
  mouseCount Int @default(0)

  mouseLeftKeyCount   Int @default(0)
  mouseRightKeyCount  Int @default(0)
  mouseMiddleKeyCount Int @default(0)
  mouseOtherKeyCount  Int @default(0)

  /// Start and end of the sampling window this row aggregates.
  windowStartUtc DateTime
  windowEndUtc   DateTime

  createdAt DateTime @default(now())

  @@index([deviceId, windowEndUtc])
  @@index([sessionId])
  @@map("activity_metrics")
}

// ---------------------------------------------------------------------------
// Activity log — Features.md "Activity Logs".
// One row per foreground-application session (or idle/lock/sleep interval).
// ---------------------------------------------------------------------------

model ActivitySession {
  id       String @id @default(uuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  sessionId         String
  attendanceSession AttendanceSession? @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  /// Agent-generated GUID for this activity session. Browser rows reference it.
  activitySessionId String @unique

  appName        String?
  processName    String?
  executablePath String?
  type           ActivityType
  windowTitle    String?

  startTime       DateTime
  endTime         DateTime
  durationSeconds Int

  reason          ActivityEndReason?
  productivityTag ProductivityTag    @default(Neutral)

  createdAt DateTime @default(now())

  browserActivities BrowserActivity[]

  @@index([deviceId, startTime])
  @@index([sessionId, startTime])
  @@index([deviceId, productivityTag])
  @@map("activity_sessions")
}

// ---------------------------------------------------------------------------
// Browser activity — Features.md "Browser Activity log".
// Linked to its owning ActivitySession via activitySessionId, per Features.md.
// ---------------------------------------------------------------------------

model BrowserActivity {
  id       String @id @default(uuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// Agent-generated GUID; dedup key.
  browserActivityId String @unique

  activitySessionId String?
  activitySession   ActivitySession? @relation(fields: [activitySessionId], references: [activitySessionId], onDelete: SetNull)

  browser        BrowserKind
  browserVersion String?
  profileName    String?

  domain      String
  rawUrl      String
  windowTitle String?
  pageTitle   String?
  protocol    UrlProtocol @default(Https)

  startTime       DateTime
  endTime         DateTime
  durationSeconds Int

  productivityTag ProductivityTag @default(Neutral)

  createdAt DateTime @default(now())

  @@index([deviceId, startTime])
  @@index([domain])
  @@index([activitySessionId])
  @@map("browser_activity")
}

// ---------------------------------------------------------------------------
// USB device events — Features.md "USB Logs".
// Connection/removal metadata only; contents are never inspected.
// ---------------------------------------------------------------------------

model UsbEvent {
  id       String @id @default(uuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  sessionId         String?
  attendanceSession AttendanceSession? @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)

  /// Agent-generated GUID; dedup key.
  clientEventId String @unique

  eventType  UsbEventType
  deviceType UsbDeviceType

  friendlyName String?
  manufacturer String?
  model        String?
  serialNumber String?
  vendorId     String?
  productId    String?

  driveLetter   String?
  volumeLabel   String?
  capacityBytes BigInt?
  fileSystem    String?

  eventTime DateTime
  createdAt DateTime @default(now())

  @@index([deviceId, eventTime])
  @@index([serialNumber])
  @@map("usb_events")
}

// ---------------------------------------------------------------------------
// Alerts — Features.md "Alert Notification".
//
// The old schema carried a `contextJson` string. It is replaced by the nullable typed
// columns below; which ones are populated depends on `type`:
//   IdleThreshold      → idleSeconds, thresholdSeconds
//   BlacklistedApp     → contextAppName, contextProcessName
//   BlacklistedWebsite → contextDomain, contextUrl
//   UsbDeviceConnected → contextUsbSerialNumber, contextUsbFriendlyName
//
// Upserted on clientEventId because an escalating incident reuses its id rather than
// creating a new row.
// ---------------------------------------------------------------------------

model Alert {
  id       String @id @default(uuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  clientEventId String @unique
  userSid       String

  type     AlertType
  severity AlertSeverity
  state    AlertState    @default(New)
  title    String
  message  String

  idleSeconds      Int?
  thresholdSeconds Int?

  contextAppName         String?
  contextProcessName     String?
  contextDomain          String?
  contextUrl             String?
  contextUsbSerialNumber String?
  contextUsbFriendlyName String?

  triggeredAt    DateTime
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  lastNotifiedAt DateTime?

  escalationLevel   Int @default(0)
  notificationCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId, triggeredAt])
  @@index([userSid, type, resolvedAt])
  @@index([severity, state])
  @@map("alerts")
}

// ---------------------------------------------------------------------------
// Screenshots — Features.md "Periodic ScreenShots". Image bytes live on disk;
// only metadata and the path are stored here.
// ---------------------------------------------------------------------------

model Screenshot {
  id       String @id @default(uuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  clientEventId String @unique
  userSid       String?

  capturedAt  DateTime
  storagePath String
  sizeBytes   Int
  width       Int?
  height      Int?

  createdAt DateTime @default(now())

  @@index([deviceId, capturedAt])
  @@map("screenshots")
}

// ---------------------------------------------------------------------------
// Policy — Features.md "Configuring Policies".
//
// Previously a single Json document. Now one row per organization with a column per
// setting, so the dashboard settings screen can update individual fields and the
// database can enforce types. `version` MUST increment on every write — the agent
// compares it to decide whether to re-prompt for consent.
// ---------------------------------------------------------------------------

model Policy {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  version Int @default(1)

  // -- Attendance ---------------------------------------------------------
  attendanceEnabled Boolean @default(true)

  // -- Activity / idle ----------------------------------------------------
  activityEnabled     Boolean @default(true)
  /// Features.md "Activity Logs": default 5-minute idle threshold.
  idleThresholdSeconds Int    @default(300)

  // -- Foreground app sampling -------------------------------------------
  appSessionEnabled       Boolean @default(true)
  appSessionPollSeconds   Int     @default(1)

  // -- Browser monitoring -------------------------------------------------
  browserMonitorEnabled   Boolean @default(true)
  browserUiaTimeoutMs     Int     @default(500)
  browserMaxRetryAttempts Int     @default(3)

  // -- Screenshots --------------------------------------------------------
  /// Features.md: enabled by default for testing, flipped off before publish.
  screenshotEnabled         Boolean @default(true)
  screenshotIntervalSeconds Int     @default(600)
  screenshotJpegQuality     Int     @default(70)

  // -- USB ----------------------------------------------------------------
  usbEnabled                     Boolean @default(true)
  usbReconciliationIntervalSeconds Int   @default(5)
  usbAlertOnInsertion            Boolean @default(false)

  // -- Alerts — Features.md: 30 Normal / 45 Moderate / 60 Severe ----------
  alertEnabled              Boolean @default(true)
  alertIdleEnabled          Boolean @default(true)
  alertIdleNormalSeconds    Int     @default(1800)
  alertIdleModerateSeconds  Int     @default(2700)
  alertIdleSevereSeconds    Int     @default(3600)
  alertIdleRenotifySeconds  Int     @default(900)
  alertBlacklistEnabled     Boolean @default(true)
  alertOutsideWorkingHours  Boolean @default(false)

  // -- Sync ---------------------------------------------------------------
  syncBatchIntervalSeconds Int @default(120)
  syncMaxBatchSize         Int @default(500)
  syncMinRetryBackoffSeconds Int @default(5)
  syncMaxRetryBackoffSeconds Int @default(120)

  // -- Retention — spec §3.1 configurable auto-deletion --------------------
  retentionDays            Int @default(90)
  undeliveredRetentionDays Int @default(30)

  // -- Working hours ------------------------------------------------------
  workingHoursStartLocal String   @default("08:00")
  workingHoursEndLocal   String   @default("17:00")
  /// Postgres text[] — a real array column, not a serialized document.
  workingDays            String[] @default(["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("policies")
}

// ---------------------------------------------------------------------------
// Productivity categorization — spec §4 "Productivity categorization", admin-editable.
// Also drives the blacklist alerts, via `isBlacklisted`.
// ---------------------------------------------------------------------------

model Category {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// App name or domain to match, case-insensitive.
  pattern       String
  target        CategoryTarget
  tag           ProductivityTag
  isBlacklisted Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, target, pattern])
  @@index([organizationId, target])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// Consent — spec §3. Proof the employee was notified before monitoring began.
// ---------------------------------------------------------------------------

model ConsentRecord {
  id       String @id @default(uuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  userSid        String
  policyVersion  Int
  acknowledgedAt DateTime
  createdAt      DateTime @default(now())

  @@unique([deviceId, userSid, policyVersion])
  @@map("consent_records")
}

// ---------------------------------------------------------------------------
// Dashboard users (Better Auth) — managers/HR/auditors. Unrelated to device identity.
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(manager)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

/// spec §9 — full audit log of who viewed what and when.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  target    String
  ipAddress String
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
  @@map("audit_logs")
}
