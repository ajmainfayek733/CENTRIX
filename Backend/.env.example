PORT=5000
NODE_ENV=development

# Postgres connection string. Prisma-compatible; add ?schema=public if needed.
DATABASE_URL="postgresql://user:password@localhost:5432/employee_tracker"

# Dashboard (Better Auth) session/user auth.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-hex-string
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Pepper for hashing Agent device API keys (HMAC-SHA256) - spec section 2.2. Rotating this invalidates
# every already-issued device API key, so treat it like any other production secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_TOKEN_PEPPER=replace-with-a-random-32-byte-hex-string

# Screenshot storage (spec section 6). Local filesystem path for the ~30-device deployment this
# backend targets; point at a mounted volume in production, or swap screenshotStorage.ts for a
# blob-storage backend (S3/Azure Blob) if volume grows.
SCREENSHOT_STORAGE_DIR=./storage/screenshots

# Base URL used to build the dashboard-authenticated screenshot viewer link returned from
# POST /api/v1/screenshots. Must be reachable by whoever views the dashboard, not by the Agent.
PUBLIC_BASE_URL=http://localhost:5000

# Maximum JSON request body. Express's 100kb default is smaller than a legitimate agent event
# batch - 500 activity sessions carrying window titles and executable paths went over it and
# every push 413'd. This is the ceiling; the agent packs each request to stay under its own
# smaller budget (BackendClient.MaxRequestBytes, 900KB), and the headroom absorbs the difference.
JSON_BODY_LIMIT=2mb

# -- Deployment topology -------------------------------------------------------
# Number of reverse proxies between the client and this server, or a value Express's
# `trust proxy` accepts ('false', 'true', 'loopback', a CIDR).
#
# Must match reality. Too low behind a proxy and every client looks like the proxy, so per-IP
# limits collapse onto one bucket. Too high - or 'true' with no proxy - and clients can forge
# x-forwarded-for to dodge those limits. 'false' means direct exposure, header ignored.
TRUST_PROXY=false

# -- Rate limits ---------------------------------------------------------------
# Enrollment is keyed per MachineGuid, not per IP, so a whole office rolling out from behind one
# NAT gets a budget per machine rather than 10/min for the entire company.
RATE_LIMIT_ENROLL_PER_MIN=10
# Per authenticated device. One agent syncs six channels plus a heartbeat every couple of
# minutes, so this is orders of magnitude above normal - it exists to contain a stuck agent.
RATE_LIMIT_INGEST_PER_MIN=200
RATE_LIMIT_SCREENSHOT_PER_MIN=60
# Per-IP backstop before authentication. Sized for an entire office behind one address.
RATE_LIMIT_UNAUTHENTICATED_PER_MIN=3000

# -- Database ------------------------------------------------------------------
# Postgres pool ceiling. Raise if many agents sync simultaneously and requests queue behind the
# pool; divide it between replicas if you run more than one instance.
DATABASE_POOL_MAX=10

# How stale a device's lastSeen may get before deviceAuth refreshes it. Writing on every request
# means a row UPDATE per telemetry call - write amplification on the hottest table for a value
# the dashboard only renders to the minute.
DEVICE_LAST_SEEN_MAX_STALENESS_SECONDS=60
