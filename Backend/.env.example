PORT=5000
NODE_ENV=development

# Postgres connection string. Prisma-compatible; add ?schema=public if needed.
DATABASE_URL="postgresql://user:password@localhost:5432/employee_tracker"

# Dashboard (Better Auth) session/user auth.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-hex-string
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Pepper for hashing Agent device API keys (HMAC-SHA256) — spec §2.2. Rotating this invalidates
# every already-issued device API key, so treat it like any other production secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_TOKEN_PEPPER=replace-with-a-random-32-byte-hex-string

# Screenshot storage (spec §6). Local filesystem path for the ~30-device deployment this
# backend targets; point at a mounted volume in production, or swap screenshotStorage.ts for a
# blob-storage backend (S3/Azure Blob) if volume grows.
SCREENSHOT_STORAGE_DIR=./storage/screenshots

# Base URL used to build the dashboard-authenticated screenshot viewer link returned from
# POST /api/v1/screenshots. Must be reachable by whoever views the dashboard, not by the Agent.
PUBLIC_BASE_URL=http://localhost:5000
