PORT=5000
NODE_ENV=development

# Postgres connection string. Prisma-compatible; add ?schema=public if needed.
DATABASE_URL="postgresql://user:password@localhost:5432/employee_tracker"

# Dashboard (Better Auth) session/user auth.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-hex-string
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Development seed credentials only. Change these before running the seed script.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-development-password
SEED_ORG_NAME=Acme Corp

# Pepper for hashing Agent device API keys (HMAC-SHA256) - spec section 2.2. Rotating this invalidates
# every already-issued device API key, so treat it like any other production secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_TOKEN_PEPPER=replace-with-a-random-32-byte-hex-string

# Screenshot storage. Use S3 in production so replacing a container does not erase screenshots.
# The AWS SDK uses its default credential chain; on AWS, prefer an IAM task/instance role over keys.
SCREENSHOT_STORAGE_PROVIDER=local
SCREENSHOT_STORAGE_DIR=./storage/screenshots
SCREENSHOT_S3_BUCKET=
SCREENSHOT_S3_REGION=us-east-1
# Optional S3-compatible endpoint for local testing (for example, LocalStack or MinIO).
SCREENSHOT_S3_ENDPOINT=
SCREENSHOT_S3_FORCE_PATH_STYLE=false

# Base URL used to build the dashboard-authenticated screenshot viewer link returned from
# POST /api/v1/screenshots. Must be reachable by whoever views the dashboard, not by the Agent.
PUBLIC_BASE_URL=http://localhost:5000

# Maximum JSON request body. Express's 100kb default is smaller than a legitimate agent event
# batch - 500 activity sessions carrying window titles and executable paths went over it and
# every push 413'd. This is the ceiling; the agent packs each request to stay under its own
# smaller budget (BackendClient.MaxRequestBytes, 900KB), and the headroom absorbs the difference.
JSON_BODY_LIMIT=2mb

# -- Deployment topology -------------------------------------------------------
# Number of reverse proxies between the client and this server, or a value Express's
# `trust proxy` accepts ('false', 'true', 'loopback', a CIDR).
#
# Must match reality. Too low behind a proxy and every client looks like the proxy, so per-IP
# limits collapse onto one bucket. Too high - or 'true' with no proxy - and clients can forge
# x-forwarded-for to dodge those limits. 'false' means direct exposure, header ignored.
TRUST_PROXY=false

# -- Rate limits ---------------------------------------------------------------
# Enrollment is keyed per MachineGuid, not per IP, so a whole office rolling out from behind one
# NAT gets a budget per machine rather than 10/min for the entire company.
RATE_LIMIT_ENROLL_PER_MIN=10
# Per authenticated device. One agent syncs six channels plus a heartbeat every couple of
# minutes, so this is orders of magnitude above normal - it exists to contain a stuck agent.
RATE_LIMIT_INGEST_PER_MIN=200
RATE_LIMIT_SCREENSHOT_PER_MIN=60
# Per-IP backstop before authentication. Sized for an entire office behind one address.
RATE_LIMIT_UNAUTHENTICATED_PER_MIN=3000

# -- Database ------------------------------------------------------------------
# Postgres pool ceiling. Raise if many agents sync simultaneously and requests queue behind the
# pool; divide it between replicas if you run more than one instance.
DATABASE_POOL_MAX=10

# How stale a device's lastSeen may get before deviceAuth refreshes it. Writing on every request
# means a row UPDATE per telemetry call - write amplification on the hottest table for a value
# the dashboard only renders to the minute.
DEVICE_LAST_SEEN_MAX_STALENESS_SECONDS=60

# -- Maintenance jobs ----------------------------------------------------------
# Server-side housekeeping nothing else will do: closing attendance sessions whose workstation
# never got the chance, and pruning the batch ledger. Each job takes a Postgres advisory lock,
# so leaving this on across several replicas still means exactly one of them sweeps.
# Set false only for an instance that should serve traffic and nothing else.
MAINTENANCE_JOBS_ENABLED=true

# -- Attendance closure --------------------------------------------------------
# A logout time is stamped by the workstation. A workstation that loses power stamps nothing,
# and its agent's own recovery pass only runs if that machine boots again - so on a site with
# scheduled load shedding the server has to be able to close those rows itself.

# How often the sweep runs. It also runs once at startup, which is the pass that clears whatever
# an outage left behind.
ATTENDANCE_REAP_INTERVAL_SECONDS=300

# THE LOAD-SHEDDING KNOB. How long a workstation must be silent - and its session unchanged -
# before the server infers an end from the last evidence it holds. The agent's own equivalent is
# 14 minutes and can afford to be: it runs on the workstation, where silence means the host
# really stopped. The server is behind the network as well, and an outage that kills the
# workstations kills the router with them, so it waits several times longer. Nothing is lost by
# waiting or by guessing wrong: a server-inferred logout is marked as such, and the agent's own
# report overwrites it whenever the machine comes back.
ATTENDANCE_ABANDON_AFTER_SECONDS=2700

# Hard ceiling on how long any session may stay open, however healthy the device looks. Sized
# above the longest plausible working day so it can never truncate a real one.
ATTENDANCE_MAX_OPEN_SECONDS=57600

# Sessions examined per sweep, and the sweep's own timeout. Together they bound the first pass
# after a long outage - a fleet that was dark for a week presents its whole backlog at once.
ATTENDANCE_REAP_MAX_SESSIONS=500
ATTENDANCE_REAP_TIMEOUT_MS=30000

# How often the batch-idempotency ledger is pruned to INGEST_BATCH_RETENTION_DAYS. It grows by
# about one row per device per channel per sync, so daily is ample.
INGEST_BATCH_PRUNE_INTERVAL_SECONDS=86400

# -- Transactional email (EmailJS) ---------------------------------------------
# Password recovery emails are sent server-side through the EmailJS REST API. In the EmailJS
# dashboard enable Account > Security > "Allow EmailJS API for non-browser applications", or
# every send is rejected with 403. Leave all four blank in development to have the recovery
# link/code logged to the console instead; in production recovery returns 503 until set.
EMAILJS_SERVICE_ID=
EMAILJS_PASSWORD_RESET_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_API_URL=https://api.emailjs.com/api/v1.0/email/send
EMAILJS_TIMEOUT_MS=10000
# Rendered into templates as {{app_name}}.
APP_NAME=CENTRIX

# -- Password recovery ---------------------------------------------------------
# link = one-click link only, code = numeric code only, both = one email carrying both.
# Links point at FRONTEND_URL/reset-password, so FRONTEND_URL must be the public dashboard URL.
PASSWORD_RESET_DELIVERY=both
PASSWORD_RESET_TTL_MINUTES=30
# Wrong guesses allowed per issued recovery before it is revoked (brute-force bound for codes).
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_CODE_LENGTH=6
